@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <h2 class="text-center mb-4">Recover your account</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    @if (string.IsNullOrEmpty(Model.SecurityQuestion))
    {
        <form asp-action="GetSecurityQuestion" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control mb-3" />

            <button class="btn btn-primary w-100">
                Find Security Question
            </button>
        </form>
    }
    else
    {
        <div class="alert alert-info">
            **Security Question:** @Model.SecurityQuestion
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Username" />
            <input type="hidden" asp-for="SecurityQuestion" />

            <div class="mb-3">
                <label asp-for="SecurityAnswer" class="form-label"></label>
                <input asp-for="SecurityAnswer" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
            </div>

            <button class="btn btn-primary w-100">
                Reset Password
            </button>
        </form>
    }

    <div class="text-center mt-3">
        <a asp-action="Login">Back to Login</a>
    </div>
</div>