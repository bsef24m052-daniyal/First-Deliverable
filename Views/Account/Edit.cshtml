@model MiniAccountViewModel

@{
    ViewData["Title"] = "Edit Mini Account";
}

<div class="form-card">
    <h2>Edit Mini Account</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Tag" class="form-label"></label>
            <input asp-for="Tag" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="AssignedBudget" class="form-label"></label>
            <input asp-for="AssignedBudget" type="number"
                   min="0.01" step="0.01" class="form-control" />
        </div>

        <button class="btn btn-primary">Save Changes</button>

        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>