@model List<MiniAccount>

@{
    ViewData["Title"] = "My Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Mini Accounts</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create Mini Account
    </a>
</div>

<div class="alert alert-info">
    Unallocated balance:
    <strong>PKR @(((decimal)ViewBag.Unallocated).ToString("N2"))</strong>
</div>

@if (ViewBag.AllocationWarning != null)
{
    <div class="alert alert-danger">
        @ViewBag.AllocationWarning
        Reduce your mini-account allocations before accessing them.
    </div>
}

<div class="row g-3">
    @foreach (var mini in Model)
    {
        var percentage = mini.AssignedBudget > 0
            ? (double)(mini.TotalSpent / mini.AssignedBudget * 100)
            : 0;

        <div class="col-md-4">
            <div class="card account-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-teal">@mini.Tag</span>

                        <a asp-action="Edit" asp-route-id="@mini.Id"
                           class="text-secondary">
                            <i class="bi bi-three-dots-vertical"></i>
                            Edit
                        </a>
                    </div>

                    <h5 class="mt-3">@mini.Name</h5>
                    <p class="text-muted">@mini.Description</p>

                    <p>Budget: PKR @mini.AssignedBudget.ToString("N2")</p>
                    <p>Spent: PKR @mini.TotalSpent.ToString("N2")</p>

                    <p class="@(mini.RemainingBalance < 0 ? "text-danger" : "text-success")">
                        Remaining: PKR @mini.RemainingBalance.ToString("N2")
                    </p>

                    <div class="progress mb-3">
                        <div class="progress-bar"
                             style="width:@Math.Clamp(percentage, 0, 100)%">
                        </div>
                    </div>

                    @if ((decimal)ViewBag.Unallocated >= 0)
                    {
                        <a asp-action="Details" asp-route-id="@mini.Id"
                           class="btn btn-primary btn-sm">
                            View Account
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled>
                            Allocations Need Adjustment
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>