@model MiniAccountViewModel

@{
    ViewData["Title"] = "Create Mini Account";
}

<div class="form-card">
    <h2>Create Mini Account</h2>

    <p class="text-muted">
        Available unallocated balance:
        PKR @(((decimal)ViewBag.Unallocated).ToString("N2"))
    </p>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Tag" class="form-label"></label>
            <input asp-for="Tag" class="form-control"
                   placeholder="e.g. Shopping, Education" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="AssignedBudget" class="form-label"></label>
            <input asp-for="AssignedBudget" type="number"
                   min="0.01" step="0.01" class="form-control" />
            <span asp-validation-for="AssignedBudget" class="text-danger"></span>
        </div>

        <button class="btn btn-primary">Create Account</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}