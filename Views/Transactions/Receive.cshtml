@{
    ViewData["Title"] = "Receive Money";
}

<div class="form-card">
    <h2>Receive Money</h2>

    <p class="text-muted">
        Received money is credited to your main account.
    </p>

    <form id="receiveForm" asp-action="Receive" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Sender Details</label>
            <input name="sender" class="form-control"
                   maxlength="200" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Amount (PKR)</label>
            <input name="amount" type="number" min="0.01"
                   step="0.01" class="form-control" required />
        </div>

        <button class="btn btn-primary w-100">
            Receive Money
        </button>

        <div id="receiveMessage" class="mt-3"></div>
    </form>
</div>