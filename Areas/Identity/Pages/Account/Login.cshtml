@page
@model FundWise.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}
<h2 class="text-center mb-4">FundWise Login</h2>

<form asp-route-returnUrl="@Model.ReturnUrl" method="post" class="col-md-6 mx-auto">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Username" class="form-label"></label>
        <input asp-for="Input.Username" class="form-control" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>

    <div class="mb-3 position-relative">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" id="pwd" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
        <button type="button" class="btn btn-outline-secondary position-absolute top-0 end-0 mt-2 me-2"
                onclick="togglePwd()">
            <i class="bi bi-eye"></i>
        </button>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary w-100">Log in</button>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-page="./ForgotCredentials">Forgot Credentials?</a>
        <a asp-page="./Register">Register to Banking</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd() {
            var pwd = document.getElementById('pwd');
            pwd.type = pwd.type === 'password' ? 'text' : 'password';
        }
    </script>
}
